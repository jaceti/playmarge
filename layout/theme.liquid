<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FFC61A">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/png" href="https://jaceti.github.io/playmarge/v17-assets/marge-logo-v17-bright.svg">
    <title>{% if page_title != blank %}{{ page_title | escape }}{% else %}Marge Games{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <meta property="og:site_name" content="Marge Games">
    <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
    <meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
    <meta property="og:image" content="https://jaceti.github.io/playmarge/v17-assets/marge-logo-v17-bright.svg">
    {{ content_for_header }}
    {{ 'marge.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'marge.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'marge-header' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'marge-footer' %}
  </body>
</html>
