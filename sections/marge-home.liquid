<div class="marge-grain" aria-hidden="true"></div>

<section class="marge-hero" id="home">
  <img class="marge-hero__splat marge-hero__splat--left" src="{{ 'hero-accent-splat-lower-left.svg' | asset_url }}" alt="" aria-hidden="true">
  <img class="marge-hero__splat marge-hero__splat--right" src="{{ 'hero-accent-splat-upper-right.svg' | asset_url }}" alt="" aria-hidden="true">
  <div class="marge-wrap marge-hero__grid">
    <div class="marge-hero__copy">
      <p class="marge-eyebrow marge-eyebrow--pink">Your everyday invitation to play.</p>
      <h1>You Bring the Party.<br><span>We Bring <span class="marge-hero__keep">the Games.</span></span></h1>
      <p class="marge-lede">From cozy digital puzzles to tabletop triumphs, Marge Games creates lighthearted ways to celebrate life’s little moments.</p>
      <div class="marge-actions">
        <a class="marge-button" href="#games">Explore Our Games</a>
        <a class="marge-text-link" href="#party-favors">Free Party Favors <span aria-hidden="true">→</span></a>
        <img class="marge-cta-die" src="{{ 'die-pink.png' | asset_url }}" alt="" aria-hidden="true">
      </div>
    </div>
    <div class="marge-hero__art" aria-label="Current Marge Games products">
      <figure class="marge-product marge-product--snack">
        <span class="marge-stage marge-stage--yellow"></span>
        <img src="{{ 'snack-society-phones.png' | asset_url }}" alt="Two phones showing Snack Society gameplay" width="1024" height="1536">
      </figure>
      <figure class="marge-product marge-product--bookish">
        <span class="marge-stage marge-stage--coral"></span>
        <img src="{{ 'bookish-box.png' | asset_url }}" alt="Bookish game box — Book club. But make it interesting." width="1254" height="1254">
        <sup class="bookish-tm" aria-label="Trademark">™</sup>
      </figure>
      <figure class="marge-product marge-product--flickmoji">
        <span class="marge-stage marge-stage--midnight"></span>
        <span class="marge-phone marge-phone--home"><img src="{{ 'flickmoji-home.webp' | asset_url }}" alt="Flickmoji home screen"></span>
        <span class="marge-phone marge-phone--game"><img src="{{ 'flickmoji-gameplay.webp' | asset_url }}" alt="Flickmoji solo movie puzzle screen"></span>
      </figure>
    </div>
  </div>
</section>

<section class="marge-pillars" aria-label="Marge Games design principles">
  <div class="marge-wrap marge-pillars__grid">
    <p><strong>01</strong><span>Easy to learn</span></p>
    <p><strong>02</strong><span>Impossible to put down</span></p>
    <p><strong>03</strong><span>A healthy dose of humor</span></p>
  </div>
</section>

<section class="marge-mission">
  <img class="marge-mission__orbit" src="{{ 'mission-orbit.svg' | asset_url }}" alt="" aria-hidden="true">
  <div class="marge-wrap marge-mission__grid">
    <div><p class="marge-eyebrow marge-eyebrow--cream">Our mission</p><h2>More reasons to gather.</h2></div>
    <p>At Marge Games, we believe every get-together—even if it’s just you and your couch—deserves a little spark. We design mobile and tabletop games that are easy to learn, impossible to put down, and packed with a healthy dose of humor.</p>
  </div>
</section>

<section class="marge-games" id="games">
  <div class="marge-wrap">
    <div class="marge-section-heading">
      <div><p class="marge-eyebrow">Pick your play</p><h2>Our Games</h2></div>
      <p>A cozy match-three, a conversation deck for readers, and a daily movie puzzle—made for every kind of game night.</p>
    </div>
    <div class="marge-game-grid">
      <article class="marge-game-card marge-game-card--snack">
        <div class="marge-game-card__art">
          <span class="marge-stage marge-stage--yellow"></span>
          <img src="{{ 'snack-society-phones.png' | asset_url }}" alt="Snack Society gameplay on two phones">
        </div>
        <div class="marge-game-card__copy">
          <p class="marge-kicker">Free · Cozy · Family</p>
          <h3>Snack Society</h3>
          <p class="marge-tagline">Satisfy your craving for a cozy match-3.</p>
          <p>Match your favorite treats, clear the board, and treat yourself to a little digital deliciousness.</p>
          <a class="marge-button" href="https://apps.apple.com/us/app/snack-society-cozy-match-3/id6761139644">Download on the App Store</a>
        </div>
      </article>

      <article class="marge-game-card marge-game-card--bookish">
        <div class="marge-game-card__art">
          <span class="marge-stage marge-stage--yellow"></span>
          <img src="{{ 'bookish-box.png' | asset_url }}" alt="Bookish conversation deck">
          <sup class="bookish-tm" aria-label="Trademark">™</sup>
        </div>
        <div class="marge-game-card__copy">
          <p class="marge-kicker">Pre-order · $22.99</p>
          <h3>Bookish</h3>
          <p class="marge-tagline">For the literary and the literal.</p>
          <p>Dust off your vocabulary and get ready to read your friends like a book.</p>
          <a class="marge-button marge-button--pink" href="/products/bookish">Learn More</a>
        </div>
      </article>

      <article class="marge-game-card marge-game-card--flickmoji">
        <a class="marge-game-card__art marge-game-card__art--link" href="/pages/flickmoji" aria-label="Learn more about Flickmoji">
          <span class="marge-stage marge-stage--midnight"></span>
          <span class="marge-phone marge-phone--home"><img src="{{ 'flickmoji-home.webp' | asset_url }}" alt="Flickmoji home screen"></span>
          <span class="marge-phone marge-phone--game"><img src="{{ 'flickmoji-gameplay.webp' | asset_url }}" alt="Flickmoji gameplay screen"></span>
        </a>
        <div class="marge-game-card__copy">
          <p class="marge-kicker">Available Now · Daily Puzzle</p>
          <h3>Flickmoji</h3>
          <p class="marge-tagline">Guess the movie one emoji at a time.</p>
          <p>Decode emoji clues, build streaks, and take on a brand-new Daily Flick every day.</p>
          <a class="marge-button marge-button--pink" href="/pages/flickmoji">Learn More</a>
        </div>
      </article>
    </div>

    <aside class="marge-signup" id="bookish-signup" aria-label="Bookish updates">
      <img src="{{ 'sparkle-sun.svg' | asset_url }}" alt="" aria-hidden="true">
      <div>
        <p class="marge-eyebrow marge-eyebrow--pink">Bookish</p>
        <h3>Be first in line when Bookish hits the shelves.</h3>
      </div>
      {% form 'customer', class: 'marge-signup__form' %}
        <input type="hidden" name="contact[tags]" value="bookish-waitlist">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <label for="BookishEmail">Email address</label>
        <input id="BookishEmail" type="email" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
        <button class="marge-button" type="submit">Get Notified</button>
        {% if form.posted_successfully? %}<p class="form-status">You’re on the list. Let the anticipation begin!</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </aside>
  </div>
</section>

<section class="marge-party" id="party-favors">
  <img class="marge-party__confetti" src="{{ 'party-confetti-corners.svg' | asset_url }}" alt="" aria-hidden="true">
  <div class="marge-wrap marge-party__grid">
    <div class="marge-party__copy">
      <p class="marge-eyebrow marge-eyebrow--cream">Party Favors</p>
      <h2>The Marge Party Pack.</h2>
      <p>Take the Marge Games spirit offline. Download our free party essentials to level up your next game night.</p>
      <p class="marge-small">Free to print at home—more party favors on the way!</p>
    </div>
    <div class="marge-party__items">
      <a class="marge-party-card" href="{{ 'MargeGames-ScoreCard.pdf' | asset_url }}" download>
        <span class="marge-stage marge-stage--coral"></span>
        <img src="{{ 'scorecard.png' | asset_url }}" alt="The Official Score Card printable">
        <span class="marge-party-card__label">Score Card <b>Download</b></span>
      </a>
      <a class="marge-party-card" href="{{ 'MargeGames-DoorHanger.pdf' | asset_url }}" download>
        <span class="marge-stage marge-stage--teal"></span>
        <img src="{{ 'doorhanger.png' | asset_url }}" alt="Do Not Disturb door hanger printable">
        <span class="marge-party-card__label">Door Hanger <b>Download</b></span>
      </a>
    </div>
  </div>
  <div class="marge-wrap">
    <div class="marge-quiz" data-quiz>
      <p class="marge-eyebrow marge-eyebrow--teal">Try the Mini Quiz!</p>
      <div data-quiz-content>
        <p class="marge-quiz__count">Question 1 of 3</p>
        <h3>Which game night vibe are you?</h3>
        <div class="marge-quiz__answers">
          <button type="button" data-score="planner">Read the rulebook cover to cover. Twice.</button>
          <button type="button" data-score="chaos">Skim the quick-start, learn as we go.</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="marge-social" id="social">
  <div class="marge-wrap">
    <div class="marge-social__intro">
      <div><p class="marge-eyebrow marge-eyebrow--yellow">Follow Along</p><h2>Fresh From Our TikTok.</h2><p>Sneak peeks, cozy snack breaks, and behind-the-scenes shenanigans—straight from our feed to your game night.</p></div>
      <a class="marge-button marge-button--light" href="https://www.tiktok.com/@play.marge">Follow @play.marge</a>
    </div>
    <div class="marge-tiktok-grid">
      <iframe src="https://www.tiktok.com/player/v1/7672819920714943757?autoplay=0&loop=0" title="Latest Play Marge TikTok video" loading="lazy" allow="encrypted-media; fullscreen" allowfullscreen></iframe>
      <iframe src="https://www.tiktok.com/player/v1/7672502358106066189?autoplay=0&loop=0" title="Recent Play Marge TikTok video" loading="lazy" allow="encrypted-media; fullscreen" allowfullscreen></iframe>
      <iframe src="https://www.tiktok.com/player/v1/7671707205749476621?autoplay=0&loop=0" title="Recent Play Marge TikTok video" loading="lazy" allow="encrypted-media; fullscreen" allowfullscreen></iframe>
    </div>
  </div>
</section>

<section class="marge-contact" id="contact">
  <div class="marge-wrap">
    <div class="marge-contact__card">
      <img class="marge-contact__sparkle" src="{{ 'sparkle-sun.svg' | asset_url }}" alt="" aria-hidden="true">
      <img class="marge-contact__dots" src="{{ 'dot-cluster-pink.svg' | asset_url }}" alt="" aria-hidden="true">
      <div><p class="marge-eyebrow marge-eyebrow--pink">Contact</p><h2>Let’s Talk Games.</h2><p>Got a question? A brilliant game idea? Just want to brag about your high score? We’re all ears—and thumbs.</p></div>
      {% form 'contact', class: 'marge-contact__form' %}
        <label>Name<input type="text" name="contact[name]" autocomplete="name" required></label>
        <label>Email<input type="email" name="contact[email]" autocomplete="email" required></label>
        <label class="marge-contact__message">What’s on your mind?<textarea name="contact[body]" rows="5" required></textarea></label>
        <button class="marge-button" type="submit">Message Us</button>
        {% if form.posted_successfully? %}<p class="form-status">Message sent. We’ll be in touch!</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Marge home",
  "settings": [],
  "presets": [{ "name": "Marge home" }]
}
{% endschema %}
